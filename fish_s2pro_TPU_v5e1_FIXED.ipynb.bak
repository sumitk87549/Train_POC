            "   📄 tokenizer_config.json                                   0.9 MB\n",
            "   📄 .cache/huggingface/.gitignore                           0.0 MB\n",
            "   📄 .cache/huggingface/download/.gitattributes.metadata      0.0 MB\n",
            "   📄 .cache/huggingface/download/LICENSE.md.metadata         0.0 MB\n",
            "   📄 .cache/huggingface/download/README.md.metadata          0.0 MB\n",
            "   📄 .cache/huggingface/download/chat_template.jinja.metadata      0.0 MB\n",
            "   📄 .cache/huggingface/download/codec.pth.metadata          0.0 MB\n",
            "   📄 .cache/huggingface/download/config.json.metadata        0.0 MB\n",
            "   📄 .cache/huggingface/download/model-00001-of-00002.safetensors.metadata      0.0 MB\n",
            "   📄 .cache/huggingface/download/model-00002-of-00002.safetensors.metadata      0.0 MB\n",
            "   📄 .cache/huggingface/download/model.safetensors.index.json.metadata      0.0 MB\n",
            "   📄 .cache/huggingface/download/overview.png.metadata       0.0 MB\n",
            "   📄 .cache/huggingface/download/special_tokens_map.json.metadata      0.0 MB\n",
            "   📄 .cache/huggingface/download/tokenizer.json.metadata      0.0 MB\n",
            "   📄 .cache/huggingface/download/tokenizer_config.json.metadata      0.0 MB\n",
            "   ───────────────────────────────────────────────────────\n",
            "   Total:                                                11.01 GB\n",
            "\n",
            "  🔍 CRITICAL FILE CHECK\n",
            "   ✅  config.json\n",
            "   ✅  codec.pth\n",
